<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quatro48"       
        x:Class="Quatro48.MainWindow"
        mc:Ignorable="d"
        Title="Quatro48"
        Height="450"
        Width="800">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="BoardPanel">
            <UniformGrid Rows="4"
                         Columns="4" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PiecePanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- selection niveau + partie -->
        <Border Grid.ColumnSpan="2"
                Margin="0 0 0 5"
                Padding="20"
                CornerRadius="12"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Background="#19000000">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Difficulté"
                               FontSize="18"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding DifficultyLevels}"
                              SelectedItem="{Binding SelectedDifficulty}"
                              Foreground="Black"
                              FontSize="16"
                              BorderThickness="0"
                              Padding="6,2"
                              Background="White" />
                </StackPanel>
                <Button Content="Nouvelle partie"
                        Command="{Binding NewGameCommand}"
                        Padding="16,6"
                        Margin="24,0,0,0"
                        FontSize="16"
                        Foreground="White"
                        Background="#FF4A6FA5"
                        BorderBrush="#6689CFF0"
                        BorderThickness="1.5"
                        Cursor="Hand"
                        HorizontalAlignment="Left" />
                <StackPanel Orientation="Vertical"
                            Margin="24,0,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="16"
                               Foreground="#E8E8F9" />
                 
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- info utilisateur -->
        <TextBlock Text="{Binding InstructionMessage}"
                   FontSize="16"
                   FontWeight="Bold"
                   Grid.Row="1"
                   Margin="0 0 0 5"
                   Grid.ColumnSpan="10"
                   Foreground="black"
                   TextWrapping="Wrap"
                  
                    />
        <!-- plateau -->
        <Border Grid.Row="2"
                Margin="0 0 20 0"
                CornerRadius="16"
                Background="#22000000"
                BorderBrush="#44FFFFFF"
                BorderThickness="1.2">
            <ItemsControl ItemsSource="{Binding BoardCells}"
                          ItemsPanel="{StaticResource BoardPanel}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin"
                                Value="6" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:BoardCellControl Piece="{Binding Piece}"
                                                   IsWinning="{Binding IsWinning}"
                                                   WinningBrush="{Binding DataContext.WinningBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Command="{Binding DataContext.PlacePieceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding DataContext.IsBoardInteractionEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <!--selection piece-->
        <Border Grid.Column="1"
                Grid.Row="2"
                CornerRadius="16"
                Background="#22000000"
                BorderBrush="#44FFFFFF"
                BorderThickness="1.2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="16,16,16,0">
                    <TextBlock Text="Pièces disponibles"
                               FontSize="18"
                               Foreground="Black"
                               FontWeight="SemiBold" />
                  
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailablePieces}"
                                  ItemsPanel="{StaticResource PiecePanel}"
                                  Margin="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPieceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Focusable="False"
                                        Padding="0"
                                        Cursor="Hand">
                                    <ContentPresenter Content="{Binding}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <!-- winner message -->
        <TextBlock Text="{Binding WinnerMessage}"
                   FontSize="16"
                   Grid.Row="3"
                   Grid.ColumnSpan="10"
                   FontWeight="Bold"
                   Foreground="black"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
    </Grid>
</Window>
