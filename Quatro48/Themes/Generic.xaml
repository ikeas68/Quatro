<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Quatro48">
    <SolidColorBrush x:Key="BoardBackgroundBrush"
                     Color="#1F1F28" />
    <SolidColorBrush x:Key="CellBorderBrush"
                     Color="#44465A" />
    <SolidColorBrush x:Key="CellBackgroundBrush"
                     Color="Transparent" />
    <SolidColorBrush x:Key="PieceBorderBrush"
                     Color="#F5F5F5" />
    <SolidColorBrush x:Key="WinningBorderBrush"
                     Color="#FFEB3B" />
    <!-- data templates -->
    <!---->
    <DataTemplate DataType="{x:Type local:PieceViewModel}">
        <local:PieceControl TopLeftBrush="{Binding TopLeftBrush}"
                            TopRightBrush="{Binding TopRightBrush}"
                            BottomLeftBrush="{Binding BottomLeftBrush}"
                            BottomRightBrush="{Binding BottomRightBrush}"
                            IsDimmed="{Binding IsDimmed}"
                            IsSelected="{Binding IsSelected}"
                            IsWinning="{Binding IsWinning}"
                            IsOnBoard="{Binding IsOnBoard}" />
    </DataTemplate>
    <!-- PieceControl -->
    <Style TargetType="{x:Type local:PieceControl}">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="Width"
                Value="80" />
        <Setter Property="Height"
                Value="80" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PieceControl}">
                    <Grid x:Name="Origin"
                          Margin="3"
                          Background="transparent">
                        <Border x:Name="Mask"
                                CornerRadius="12"
                                Background="Black"
                                BorderThickness="0"
                                Margin="5"
                                Visibility="Visible"
                                 />
                        <Grid x:Name="Root"
                              Visibility="Visible"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=Mask}" />
                            </Grid.OpacityMask>
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1.0"
                                                ScaleY="1.0" />
                            </Grid.RenderTransform>
                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0"
                                        Grid.Column="0"
                                        Background="{TemplateBinding TopLeftBrush}" />
                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Background="{TemplateBinding TopRightBrush}" />
                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Background="{TemplateBinding BottomLeftBrush}" />
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Background="{TemplateBinding BottomRightBrush}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--<Trigger Property="IsDimmed"
                                 Value="True">
                            <Setter TargetName="BaseBorder"
                                    Property="Opacity"
                                    Value="0.45" />
                        </Trigger>-->
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Origin"
                                    Property="Opacity"
                                    Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.3"
                                                    ScaleY="1.3" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Origin"
                                    Property="ZIndex"
                                    Value="1" />
                            <Setter TargetName="Origin"
                                    Property="Opacity"
                                    Value="1" />
                        </Trigger>
                       
                        <!--<Trigger Property="IsWinning"
                                 Value="True">
                            <Setter TargetName="Selection"
                                    Property="BorderBrush"
                                    Value="{StaticResource WinningBorderBrush}" />
                            <Setter TargetName="Selection"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>-->
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDimmed"
                                           Value="False" />
                                <Condition Property="IsOnBoard"
                                           Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BaseBorder"
                                    Property="Opacity"
                                    Value="1" />
                        </MultiTrigger>-->
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDimmed"
                                           Value="False" />
                                <Condition Property="IsOnBoard"
                                           Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BaseBorder"
                                    Property="Opacity"
                                    Value="0.75" />
                        </MultiTrigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->
    <Style TargetType="{x:Type local:BoardCellControl}">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BoardCellControl}">
                    <Grid>
                        <Border x:Name="CellBackground"
                                Background="{StaticResource CellBackgroundBrush}"
                                BorderBrush="{StaticResource CellBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="12" />
                        <ContentPresenter x:Name="PiecePresenter"
                                          Content="{TemplateBinding Piece}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <Border x:Name="Highlight"
                                Background="{TemplateBinding WinningBrush}"
                                CornerRadius="12"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="CellBackground"
                                    Property="Opacity"
                                    Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsWinning"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="WinningBlink">
                                    <Storyboard RepeatBehavior="Forever"
                                                AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Highlight"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.15"
                                                         To="0.7"
                                                         Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="WinningBlink" />
                            </Trigger.ExitActions>
                            <Setter TargetName="Highlight"
                                    Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
