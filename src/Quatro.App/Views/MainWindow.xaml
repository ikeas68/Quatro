<Window x:Class="Quatro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Quatro.Controls"
        xmlns:vm="clr-namespace:Quatro.ViewModels"
        Title="Quatro"
        Height="720"
        Width="1100"
        Background="{StaticResource BoardBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="BoardPanel">
            <UniformGrid Rows="4" Columns="4" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PiecePanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2"
                Margin="0 0 0 16"
                Padding="20"
                CornerRadius="12"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Background="#19000000">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Difficulté"
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding DifficultyLevels}"
                              SelectedItem="{Binding SelectedDifficulty}"
                              Foreground="White"
                              FontSize="16"
                              BorderThickness="0"
                              Padding="6,2"
                              Background="#33222244" />
                </StackPanel>
                <Button Content="Nouvelle partie"
                        Command="{Binding NewGameCommand}"
                        Padding="16,6"
                        Margin="24,0,0,0"
                        FontSize="16"
                        Foreground="White"
                        Background="#FF4A6FA5"
                        BorderBrush="#6689CFF0"
                        BorderThickness="1.5"
                        Cursor="Hand"
                        HorizontalAlignment="Left" />
                <StackPanel Orientation="Vertical" Margin="24,0,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="16"
                               Foreground="#E8E8F9" />
                    <TextBlock Text="{Binding InstructionMessage}"
                               FontSize="16"
                               Foreground="#B8C2E5"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               MaxWidth="420" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0 0 20 0"
                CornerRadius="16"
                Background="#22000000"
                BorderBrush="#44FFFFFF"
                BorderThickness="1.2">
            <ItemsControl ItemsSource="{Binding BoardCells}"
                          ItemsPanel="{StaticResource BoardPanel}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="6" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardCellViewModel}">
                        <controls:BoardCellControl Piece="{Binding Piece}"
                                                   IsWinning="{Binding IsWinning}"
                                                   WinningBrush="{Binding DataContext.WinningBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Command="{Binding DataContext.PlacePieceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding DataContext.IsBoardInteractionEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="1"
                CornerRadius="16"
                Background="#22000000"
                BorderBrush="#44FFFFFF"
                BorderThickness="1.2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,0">
                    <TextBlock Text="Pièces disponibles"
                               FontSize="18"
                               Foreground="White"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WinnerMessage}"
                               FontSize="16"
                               Foreground="#FFD966"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailablePieces}"
                                  ItemsPanel="{StaticResource PiecePanel}"
                                  Margin="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PieceViewModel}">
                                <Button Command="{Binding DataContext.SelectPieceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Focusable="False"
                                        Padding="0"
                                        Cursor="Hand">
                                    <ContentPresenter Content="{Binding}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
